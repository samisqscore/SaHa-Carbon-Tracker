# ==============================================================================
# SaHa Carbon Footprint Tracker - Environment Configuration Template
# Copy this file to .env and configure the values for your local environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Required)
# ------------------------------------------------------------------------------
# PostgreSQL connection string. 
# Default below works out-of-the-box with `docker compose up -d`.
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/saha_carbon_tracker

# ------------------------------------------------------------------------------
# 2. Session & Server Security (Required)
# ------------------------------------------------------------------------------
# Secret key used to sign Express session cookies.
# In production, generate a secure random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=dev_session_secret_change_in_production_min32chars

# Application environment ('development' | 'production')
NODE_ENV=development

# Server port and host binding
PORT=5001
HOST=127.0.0.1

# Base URL used for OAuth callbacks and link generation
BASE_URL=http://localhost:5001

# ------------------------------------------------------------------------------
# 3. Authentication - Google OAuth 2.0 (Optional for local dev, required for Google Login)
# ------------------------------------------------------------------------------
# Obtain these credentials from the Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5001/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email address to automatically promote to Super Admin upon first login
INITIAL_ADMIN_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# 4. AI & Intelligence Services (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API key (used for BOQ material mapping and recommendation agents)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# DeepSeek API key (OpenAI-compatible alternative for material matching)
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# 5. External EPD Mirror Database (Optional)
# ------------------------------------------------------------------------------
# Read-only connection to an external Environmental Product Declaration (EPD) database.
# Leave blank if you are using only the built-in seed datasets (India BEI, ICE v3).
EPD_DATABASE_URL=

# ------------------------------------------------------------------------------
# 6. SMTP Email Notifications (Optional)
# ------------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
